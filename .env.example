# =============================================
# VARIABLES DE ENTORNO — MAGNO BIENES RAÍCES
# =============================================

# --- Cliente (VITE_*): se incrustan en el bundle del navegador. SOLO datos públicos. ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APPWRITE CLOUD BACKEND (https://cloud.appwrite.io)
# Solo lectura pública. Las escrituras van por las funciones serverless.
VITE_APPWRITE_ENDPOINT="https://sfo.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="6a7e4f6f0037477961d2"
VITE_APPWRITE_DATABASE_ID="magno_db"
VITE_APPWRITE_COLLECTION_ID="properties"
VITE_APPWRITE_BUCKET_ID="property_images"

# --- Servidor (sin VITE_): SOLO en Vercel -> Settings -> Environment Variables. NUNCA en git ni en el navegador. ---
# API Key de Appwrite generada en Console -> API Keys
# (scopes: databases.*, documents.*, files.*, buckets.* — sin usuarios)
APPWRITE_API_KEY="genera-una-api-key-solo-para-servidor"

# Correo y contraseña del administrador del panel (/admin)
ADMIN_EMAIL="magnobr.cr@gmail.com"
ADMIN_PASSWORD="usa-una-contraseña-fuerte-y-larga"

# Secreto para firmar los tokens de sesión del admin (cadena aleatoria larga, ej. openssl rand -hex 32)
ADMIN_TOKEN_SECRET="cambia-por-una-cadena-aleatoria-larga"
